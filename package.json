{
  "name": "mtg-maxs-cube",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "cube": "tsx apps/cli/src/index.ts",
    "check": "tsx scripts/src/check.ts",
    "fix": "tsx scripts/src/fix.ts",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint:md": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "export": "tsx scripts/src/export.ts",
    "dev": "turbo run dev --filter=@repo/web",
    "desktop": "turbo run build:desktop --filter=@repo/web && pnpm --filter @repo/desktop dev",
    "desktop:build": "turbo run build --filter=@repo/desktop && pnpm --filter @repo/desktop package",
    "handoff": "tsx scripts/src/handoff.ts",
    "tidy": "tsx scripts/src/tidy.ts",
    "skills:setup": "claude plugin marketplace add ./ --scope local",
    "skills:eval": "claude plugin eval packages/skills"
  },
  "prettier": "@repo/prettier-config",
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@repo/markdownlint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10"
  }
}
