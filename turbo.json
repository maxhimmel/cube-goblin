{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "src/generated/**"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "src/generated/**"],
      "outputs": ["dist/**"]
    },
    "e2e:workbench": {
      "dependsOn": ["^build"]
    },
    "e2e:share": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/generated/**",
        "$TURBO_ROOT$/cube/**",
        "$TURBO_ROOT$/cube.config.json"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "@repo/web#build:desktop": {
      "dependsOn": ["^build"],
      "outputs": ["dist-desktop/**"]
    },
    "@repo/desktop#build": {
      "dependsOn": ["^build", "@repo/web#build:desktop"],
      "outputs": ["out/**"]
    },
    "e2e:desktop": {
      "dependsOn": ["build"]
    }
  }
}
