{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "src/generated/**"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "src/generated/**"],
      "outputs": ["dist/**"]
    },
    "e2e": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/generated/**",
        "$TURBO_ROOT$/cube/**",
        "$TURBO_ROOT$/cube.config.json"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
